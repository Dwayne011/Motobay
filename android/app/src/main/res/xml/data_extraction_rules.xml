<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as backup_rules.xml for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="sharedpref" path="crashlog.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="sharedpref" path="crashlog.xml" />
    </device-transfer>
</data-extraction-rules>
